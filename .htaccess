# MeetSpace root hardening for Apache/XAMPP
Options -Indexes

# Only public entry points and assets may be served by Apache. Internal source,
# tests, migrations, build dependencies, and operational documentation stay
# available to CLI/Git but are deliberately hidden from HTTP clients.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|database|docs|bootstrap|config|migrations|node_modules|scripts|src|tests)(?:/|$) - [R=404,L,NC]
</IfModule>

# Block files that must never be served directly by the web server.
<FilesMatch "(?i)(^\.env|\.sql$|^README(?:\..*)?$|^package.*\.json$|^(?:config|configuration)\.(?:php|inc)$|^test_db\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent access to common local metadata and dependency manifests.
<FilesMatch "(?i)^(?:composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|\.gitignore|\.gitattributes)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always unset X-Powered-By
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Runtime aplikasi lokal. Gunakan false agar detail error tidak tampil kepada pengguna.
APP_ENV="local_lan"
APP_DEBUG="false"
APP_ALLOW_REGISTRATION="false"
APP_LOG_PATH="C:/xampp/private/Room_Booking_System/logs/application.log"

# Session hanya berlaku pada path aplikasi dan berakhir setelah 2 jam tidak aktif.
SESSION_COOKIE_PATH="/Room_Booking_System/"
SESSION_IDLE_TIMEOUT="7200"
TRUST_PROXY_HEADERS="false"

# Database XAMPP. Untuk operasional, gunakan akun khusus aplikasi dengan hak
# SELECT, INSERT, UPDATE, dan DELETE; jangan gunakan root tanpa password.
DB_HOST="localhost"
DB_USER="meetspace_app"
DB_PASS="ganti-dengan-password-database-yang-kuat"
DB_NAME="meetspace_db"

# Direktori privat di luar htdocs untuk dokumen pengajuan booking.
BOOKING_DOCUMENT_STORAGE="C:/xampp/private/Room_Booking_System/booking-documents"
